    <style>

        /* Estilo para el fondo */

        body {

            margin: 0;

            height: 100vh;

            background: linear-gradient(to bottom, #ff9a9e, #fad0c4); /* Degradado de rosa fuerte a rosa claro */

            display: flex;

            justify-content: center;

            align-items: center;

            font-family: 'Arial', sans-serif;

        }



        /* Estilo para el contenido */

        .contenido {

            text-align: center;

            color: white;

            font-size: 2em;

        }



        /* Círculo animado */

        .circulo {

            width: 50px;

            height: 50px;

            background-color: #FF69B4;

            border-radius: 50%;

            position: absolute;

            animation: expandir 2s infinite ease-in-out alternate;

        }

 @keyframes expandir {

            0% {

                transform: scale(1);

                opacity: 0.7;

            }

            100% {

                transform: scale(3);

                opacity: 0.1;

            }

        }



 /* Cuadrado blanco en el centro */

        .cuadrado {

            border-radius: 0.7rem;

            width: 350px;

            height: 350px;

            background-color: white;

            display: flex;

            justify-content: center;

            align-items: center;

border: 0.35rem solid #FF69B4;

            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);

            border: 0.35rem solid $s-color;

            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2); /* Sombra sutil */

        }

 /* Estilo para el contenido dentro del cuadrado */

        .contenido {

            text-align: center;

            color: #FF69B4; /* Texto rosa para contrastar con el fondo blanco */

            font-size: 1.5em;

        }



 /* Corazón animado */

        .corazon {

            position: absolute;

            width: 50px;

            height: 50px;

            background-color: #FF69B4;

            transform: rotate(-45deg);

            animation: latido 1.5s infinite ease-in-out;

        }



        .corazon::before,

        .corazon::after {

            content: "";

            position: absolute;

            width: 50px;

            height: 50px;

            background-color: #FF69B4;

            border-radius: 50%;

        }



        .corazon::before {

            top: -25px;

            left: 0;

        }



        .corazon::after {

            left: 25px;

            top: 0;

        }



        /* Animación de latido */

        @keyframes latido {

            0% {

                transform: scale(1) rotate(-45deg);

            }

            50% {

                transform: scale(1.2) rotate(-45deg);

            }

            100% {

                transform: scale(1) rotate(-45deg);

            }

        }











 /* Tarjeta de amor */

        .tarjeta {

            position: absolute;

            width: 300px;

            height: 150px;

            background: #fad0c4;

            border-radius: 10px;

            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);

            display: flex;

            flex-direction: column;

            justify-content: center;

            align-items: center;

            text-align: center;

            padding: 20px;

            opacity: 0;

            transform: scale(0.5);

            transition: opacity 0.5s ease, transform 0.5s ease;

        }



        

 





        /* Mostrar la tarjeta */

        .tarjeta.mostrar {

            opacity: 1;

            transform: scale(1);

        }



        /* Botón para cerrar la tarjeta */

        .cerrar {

            margin-top: 10px;

            background: #FF69B4;

            color: white;

            border: none;

            padding: 10px 15px;

            border-radius: 5px;

            cursor: pointer;

        }



        /* Jardín de flores */

        .jardin {

            display: flex;

            gap: 20px;

            margin-top: 10px;

        }



        /* Estilo de las flores */

        .flor {

            position: relative;

            width: 20px;

            height: 60px;

            background: green;

            border-radius: 5px;

        }



        /* Pétalos */

        .flor .petalo {

            position: absolute;

            width: 20px;

            height: 20px;

            background: #ff3370;

            border-radius: 50%;

        }



        .flor .petalo:nth-child(1) { top: -15px; left: -10px; }

        .flor .petalo:nth-child(2) { top: -15px; left: 10px; }

        .flor .petalo:nth-child(3) { top: -30px; left: 0; }

        .flor .petalo:nth-child(4) { top: -10px; left: 0; }



        /* Centro de la flor */

        .flor .centro {

            position: absolute;

            width: 10px;

            height: 12px;

            background: yellow;

            border-radius: 50%;

            top: -20px;

            left: 4px;

        }



        /* Hojas */

        .hoja {

            position: absolute;

            width: 15px;

            height: 10px;

            background: green;

            border-radius: 50%;

            top: 30px;

        }



        .hoja.izquierda {

            left: -10px;

            transform: rotate(-30deg);

        }



        .hoja.derecha {

            right: -10px;

            transform: rotate(30deg);

        }





/* Animación de corazón flotante en la segunda tarjeta */

        .corazon-flotante {

            position: absolute;

            bottom: -50px;

            width: 30px;

            height: 30px;

            background: red;

            transform: rotate(-45deg);

            animation: flotar 3s infinite ease-in-out;

        }



        .corazon-flotante::before,

        .corazon-flotante::after {

            content: "";

            position: absolute;

            width: 30px;

            height: 30px;

            background: red;

            border-radius: 50%;

        }



        .corazon-flotante::before { top: -15px; left: 0; }

        .corazon-flotante::after { left: 15px; top: 0; }



        @keyframes flotar {

            0% { transform: translateY(0) rotate(-45deg); opacity: 1; }

            50% { transform: translateY(-100px) rotate(-45deg); opacity: 0.5; }

            100% { transform: translateY(-150px) rotate(-45deg); opacity: 0; }

        }







      button {

            background-color: #ff69b4; /* Color rosa */

            color: white;

